# Provider: fau | gemini | (empty -> LLM_API_KEY / LLM_BASE_URL, e.g. Groq or xAI)
LLM_PROVIDER=fau
FAU_API_KEY=your_fau_api_key_here
FAU_BASE_URL=https://hub.nhr.fau.de/api/llmgw/v1
LLM_MODEL=gpt-oss-120b
# optional: used automatically if the main model is overloaded
# LLM_FALLBACK_MODEL=

# Gemini backup (LLM_PROVIDER=gemini)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MODEL=gemini-3.5-flash
